# GEMINI_API_KEY: Optional fallback Gemini API key on the server.
# Super Admin can also configure/replace the single Gemini API key directly inside the Admin UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPER_ADMIN_EMAILS: Comma-separated Super Admin emails (verified server-side via Firebase ID token)
SUPER_ADMIN_EMAILS="tuankhang2011pm@gmail.com,tuankhangnek@gmail.com"

# SUPER_ADMIN_UID: Optional explicit Firebase UID of the existing Super Admin account
SUPER_ADMIN_UID=""

# Optional: Set ALLOWED_ORIGIN and VITE_API_BASE_URL only if hosting static frontend separately from Node backend
ALLOWED_ORIGIN=""
VITE_API_BASE_URL=""

